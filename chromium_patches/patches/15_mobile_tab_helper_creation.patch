@@ -XXX,6 +XXX,18 @@ void Browser::TabInsertedAt(TabStripModel* tab_strip_model,
   // ... existing code ...

+#if BUILDFLAG(IS_WIN)
+  // BladeBlaid: Create mobile emulation tab helper if needed
+  const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+  if (cmd.HasSwitch("bladeblaid-profile") &&
+      cmd.HasSwitch("bladeblaid-mobile")) {
+    std::string profile_id = cmd.GetSwitchValueASCII("bladeblaid-profile");
+    bladeblaid::MaybeCreateMobileEmulationTabHelper(
+        contents->web_contents(),
+        profile_id);
+  }
+#endif
+
 }

