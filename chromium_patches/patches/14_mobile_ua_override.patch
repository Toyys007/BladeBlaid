@@ -XXX,6 +XXX,15 @@ void Navigator::DidStartMainFrameNavigation(
   // ... existing code ...

+#if BUILDFLAG(IS_WIN)
+  // BladeBlaid: Override user agent for mobile profiles
+  if (bladeblaid::ShouldUseMobileUserAgent()) {
+    std::string mobile_ua = bladeblaid::GetMobileUserAgentOverride();
+    if (!mobile_ua.empty()) {
